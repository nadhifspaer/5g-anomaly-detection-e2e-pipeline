# FastAPI service image, also reused (command override) for streaming/producer.py and streaming/consumer.py. Build context is the repo root.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY api/ api/
COPY streaming/ streaming/
COPY data/ data/

# mlruns/ is bind-mounted read-only at runtime, never baked into the image; train a run first via notebooks/02 if empty
RUN mkdir -p mlruns

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
