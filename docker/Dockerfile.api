# FastAPI service image. Also reused (command override) for streaming/producer.py
# and streaming/consumer.py in docker-compose.yml, see architecture.md Section 4
# Mode 2, Section 6. Build context is the repo root.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY api/ api/
COPY streaming/ streaming/
COPY data/ data/

# mlruns/ is bind-mounted read-only at runtime (docker-compose), never baked
# into the image, so the container always loads whatever MLflow run is
# latest on the host; train one first via notebooks/02 if empty
RUN mkdir -p mlruns

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
